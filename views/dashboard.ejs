<%- include('partials/header') %>

<div class="page-header">
  <div>
    <h1>Hong Kong Trails &amp; Meetups</h1>
    <p>Discover routes, filter by conditions, organize group hikes, and manage trail records.</p>
  </div>
  <a href="/trails/new" class="btn btn-primary">+ Create New Trail</a>
</div>

<section class="stats-grid">
  <div class="stat-card">
    <div class="stat-label">Total Trails</div>
    <div class="stat-value"><%= stats.totalCount %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Open Status</div>
    <div class="stat-value"><%= stats.openCount %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Combined Distance</div>
    <div class="stat-value"><%= stats.totalDistance %> km</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Active Hike RSVPs</div>
    <div class="stat-value"><%= stats.totalRsvps %></div>
  </div>
</section>

<section class="filter-card">
  <form action="/trails" method="GET">
    <div class="filter-grid">
      <div>
        <label for="q" style="font-size:0.8rem; font-weight:600; display:block; margin-bottom:4px;">Keyword Search</label>
        <input
          type="text"
          id="q"
          name="q"
          class="form-control"
          value="<%= filters.q %>"
          placeholder="Trail name, MTR point, gear..."
        >
      </div>

      <div>
        <label for="district" style="font-size:0.8rem; font-weight:600; display:block; margin-bottom:4px;">District</label>
        <select id="district" name="district" class="form-control">
          <option value="">All Districts</option>
          <% districts.forEach((d) => { %>
            <option value="<%= d %>" <%= filters.district === d ? 'selected' : '' %>><%= d %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label for="difficulty" style="font-size:0.8rem; font-weight:600; display:block; margin-bottom:4px;">Difficulty</label>
        <select id="difficulty" name="difficulty" class="form-control">
          <option value="">All Levels</option>
          <% difficulties.forEach((lvl) => { %>
            <option value="<%= lvl %>" <%= filters.difficulty === lvl ? 'selected' : '' %>><%= lvl %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label for="status" style="font-size:0.8rem; font-weight:600; display:block; margin-bottom:4px;">Status</label>
        <select id="status" name="status" class="form-control">
          <option value="">All Statuses</option>
          <% statuses.forEach((st) => { %>
            <option value="<%= st %>" <%= filters.status === st ? 'selected' : '' %>><%= st %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label for="maxDistance" style="font-size:0.8rem; font-weight:600; display:block; margin-bottom:4px;">Max Distance (km)</label>
        <input
          type="number"
          step="0.5"
          min="1"
          id="maxDistance"
          name="maxDistance"
          class="form-control"
          value="<%= filters.maxDistance %>"
          placeholder="e.g. 10"
        >
      </div>

      <div>
        <label for="sort" style="font-size:0.8rem; font-weight:600; display:block; margin-bottom:4px;">Sort By</label>
        <select id="sort" name="sort" class="form-control">
          <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest Added</option>
          <option value="distance_asc" <%= filters.sort === 'distance_asc' ? 'selected' : '' %>>Shortest Distance</option>
          <option value="distance_desc" <%= filters.sort === 'distance_desc' ? 'selected' : '' %>>Longest Distance</option>
          <option value="elevation_desc" <%= filters.sort === 'elevation_desc' ? 'selected' : '' %>>Highest Elevation</option>
          <option value="meetup_asc" <%= filters.sort === 'meetup_asc' ? 'selected' : '' %>>Soonest Meetup</option>
        </select>
      </div>
    </div>

    <div class="filter-actions">
      <a href="/trails" class="btn btn-secondary btn-sm">Reset Filters</a>
      <button type="submit" class="btn btn-primary btn-sm">Search &amp; Filter</button>
    </div>
  </form>
</section>

<% if (trails.length === 0) { %>
  <div class="empty-state">
    <h3>No matching trails found</h3>
    <p>Try adjusting your search conditions or add a new hiking trail to the hub.</p>
    <a href="/trails/new" class="btn btn-primary">+ Add First Matching Trail</a>
  </div>
<% } else { %>
  <p style="margin-bottom:14px; font-size:0.9rem; color:var(--text-muted);">
    Showing <strong><%= trails.length %></strong> trail<%= trails.length === 1 ? '' : 's' %>
  </p>

  <section class="trail-grid">
    <% trails.forEach((trail) => { %>
      <%
        const diffClass = 'badge-' + trail.difficulty.toLowerCase();
        const statusClass =
          trail.trailStatus === 'Open'
            ? 'badge-status-open'
            : trail.trailStatus === 'Maintenance'
            ? 'badge-status-maintenance'
            : 'badge-status-caution';
        const joined = trail.participants && trail.participants.includes(currentUser.username);
      %>
      <article class="trail-card">
        <div>
          <div class="trail-badges">
            <span class="badge <%= diffClass %>"><%= trail.difficulty %></span>
            <span class="badge <%= statusClass %>"><%= trail.trailStatus %></span>
          </div>

          <h2 class="trail-title">
            <a href="/trails/<%= trail._id %>"><%= trail.trailName %></a>
          </h2>
          <div class="trail-district"><%= trail.district %> &middot; <%= trail.meetingPoint %></div>
          <p class="trail-desc"><%= trail.description %></p>

          <div class="trail-metrics">
            <div>
              <div class="metric-val"><%= trail.distanceKm %> km</div>
              <div class="metric-lbl">Distance</div>
            </div>
            <div>
              <div class="metric-val"><%= trail.durationHrs %> hrs</div>
              <div class="metric-lbl">Duration</div>
            </div>
            <div>
              <div class="metric-val"><%= trail.elevationM %> m</div>
              <div class="metric-lbl">Elevation</div>
            </div>
          </div>

          <div class="trail-meta">
            <strong>Meetup:</strong> <%= trail.meetupDate || 'Flexible' %> &nbsp;|&nbsp;
            <strong>Hikers:</strong> <%= trail.participants ? trail.participants.length : 0 %> / <%= trail.maxParticipants %>
          </div>
        </div>

        <div class="trail-card-footer">
          <form action="/trails/<%= trail._id %>/join" method="POST" style="display:inline;">
            <button type="submit" class="btn btn-sm <%= joined ? 'btn-secondary' : 'btn-accent' %>">
              <%= joined ? 'Leave Hike' : 'Join Hike' %>
            </button>
          </form>

          <div class="card-btn-group">
            <a href="/trails/<%= trail._id %>" class="btn btn-secondary btn-sm">View</a>
            <a href="/trails/<%= trail._id %>/edit" class="btn btn-primary btn-sm">Edit</a>
            <form
              action="/trails/<%= trail._id %>/delete"
              method="POST"
              style="display:inline;"
              data-confirm="Delete '<%= trail.trailName %>'? This cannot be undone."
            >
              <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            </form>
          </div>
        </div>
      </article>
    <% }) %>
  </section>
<% } %>

<%- include('partials/footer') %>
