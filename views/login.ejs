<%- include('partials/header') %>

<div class="auth-wrapper">
  <div class="panel">
    <div class="auth-header">
      <h1 class="glow-title">TrailMate HK</h1>
      <p data-i18n="auth_signin_sub">Sign in to manage Hong Kong trails, transport guides &amp; forum posts.</p>
    </div>

    <% if (error) { %>
      <div class="flash flash-danger" style="margin-bottom:16px;">
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/login" method="POST">
      <div class="form-group">
        <label for="username" data-i18n="auth_username">Username</label>
        <input type="text" id="username" name="username" class="form-control" value="<%= username || '' %>" placeholder="Enter your username" required autofocus>
      </div>

      <div class="form-group">
        <label for="password" data-i18n="auth_password">Password</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="Enter your password" required>
      </div>

      <button type="submit" class="btn btn-emerald" style="width:100%;" data-i18n="auth_signin_btn">Sign In</button>
    </form>

    <div class="demo-box">
      <strong data-i18n="auth_demo_title">Pre-Seeded Demo Accounts</strong>
      <div>Admin: <code>admin</code> / <code>password123</code></div>
      <div>Organizer: <code>hiker1</code> / <code>password123</code></div>
      <div class="demo-actions">
        <button type="button" class="btn btn-secondary btn-sm" data-demo-user="admin" data-demo-pass="password123">Fill Admin</button>
        <button type="button" class="btn btn-secondary btn-sm" data-demo-user="hiker1" data-demo-pass="password123">Fill Organizer</button>
      </div>
    </div>

    <p style="text-align:center; margin-top:18px; font-size:0.88rem; color:var(--text-muted);">
      New to TrailMate HK? <a href="/register"><strong data-i18n="nav_register">Register</strong></a>
    </p>
  </div>
</div>

<%- include('partials/footer') %>
