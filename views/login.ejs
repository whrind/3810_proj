<%- include('partials/header') %>

<div class="auth-wrapper">
  <div class="card">
    <div class="auth-header">
      <h1>Welcome to TrailMate HK</h1>
      <p>Sign in to manage Hong Kong hiking trails and group meetups.</p>
    </div>

    <% if (error) { %>
      <div class="flash flash-danger" style="margin-bottom:16px;">
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/login" method="POST">
      <div class="form-group">
        <label for="username">Username</label>
        <input
          type="text"
          id="username"
          name="username"
          class="form-control"
          value="<%= username || '' %>"
          placeholder="Enter your username"
          required
          autofocus
        >
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          class="form-control"
          placeholder="Enter your password"
          required
        >
      </div>

      <button type="submit" class="btn btn-primary" style="width:100%;">Sign In</button>
    </form>

    <div class="demo-box">
      <strong>Demo Accounts (Pre-seeded)</strong>
      <div>Admin: <code>admin</code> / <code>password123</code></div>
      <div>Organizer: <code>hiker1</code> / <code>password123</code></div>
      <div class="demo-actions">
        <button type="button" class="btn btn-secondary btn-sm" data-demo-user="admin" data-demo-pass="password123">Fill Admin</button>
        <button type="button" class="btn btn-secondary btn-sm" data-demo-user="hiker1" data-demo-pass="password123">Fill Organizer</button>
      </div>
    </div>

    <p style="text-align:center; margin-top:18px; font-size:0.9rem; color:var(--text-muted);">
      New to TrailMate HK? <a href="/register"><strong>Create an account</strong></a>
    </p>
  </div>
</div>

<%- include('partials/footer') %>
