<%- include('partials/header') %>

<div class="container-narrow">
  <div class="workspace-header">
    <div>
      <h1 class="glow-title" style="font-size:1.85rem;">Edit Trail</h1>
      <p class="header-subtitle">Updating: <strong><%= trail.trailName %></strong></p>
    </div>
    <a href="/trails/<%= trail._id %>" class="btn btn-secondary">&larr; Back to Detail</a>
  </div>

  <div class="panel">
    <% if (error) { %>
      <div class="flash flash-danger" style="margin-bottom:18px;">
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/trails/<%= trail._id %>/update" method="POST">
      <div class="form-grid">
        <div class="form-group">
          <label for="trailName">Trail Name *</label>
          <input type="text" id="trailName" name="trailName" class="form-control" value="<%= trail.trailName || '' %>" required>
        </div>
        <div class="form-group">
          <label for="district">District *</label>
          <select id="district" name="district" class="form-control" required>
            <% districts.forEach((d) => { %>
              <option value="<%= d %>" <%= trail.district === d ? 'selected' : '' %>><%= d %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="form-grid-3">
        <div class="form-group">
          <label for="difficulty">Difficulty *</label>
          <select id="difficulty" name="difficulty" class="form-control" required>
            <% difficulties.forEach((lvl) => { %>
              <option value="<%= lvl %>" <%= trail.difficulty === lvl ? 'selected' : '' %>><%= lvl %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="trailStatus">Trail Status</label>
          <select id="trailStatus" name="trailStatus" class="form-control">
            <% statuses.forEach((st) => { %>
              <option value="<%= st %>" <%= trail.trailStatus === st ? 'selected' : '' %>><%= st %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="meetupDate">Meetup Date</label>
          <input type="date" id="meetupDate" name="meetupDate" class="form-control" value="<%= trail.meetupDate || '' %>">
        </div>
      </div>

      <div class="form-grid-3">
        <div class="form-group">
          <label for="distanceKm">Distance (km) *</label>
          <input type="number" step="0.1" min="0.5" max="150" id="distanceKm" name="distanceKm" class="form-control" value="<%= trail.distanceKm %>" required>
        </div>
        <div class="form-group">
          <label for="durationHrs">Duration (hours) *</label>
          <input type="number" step="0.5" min="0.5" max="48" id="durationHrs" name="durationHrs" class="form-control" value="<%= trail.durationHrs %>" required>
        </div>
        <div class="form-group">
          <label for="elevationM">Elevation Gain (m)</label>
          <input type="number" min="0" id="elevationM" name="elevationM" class="form-control" value="<%= trail.elevationM || 0 %>">
        </div>
      </div>

      <div class="form-grid">
        <div class="form-group">
          <label for="meetingPoint">Meeting Point *</label>
          <input type="text" id="meetingPoint" name="meetingPoint" class="form-control" value="<%= trail.meetingPoint || '' %>" required>
        </div>
        <div class="form-group">
          <label for="maxParticipants">Max Participants</label>
          <input type="number" min="1" max="100" id="maxParticipants" name="maxParticipants" class="form-control" value="<%= trail.maxParticipants || 12 %>">
        </div>
      </div>

      <div class="form-grid">
        <div class="form-group">
          <label for="nearestMtr">Nearest MTR Station &amp; Exit</label>
          <input type="text" id="nearestMtr" name="nearestMtr" class="form-control" value="<%= trail.nearestMtr || '' %>">
        </div>
        <div class="form-group">
          <label for="busRoutes">Bus / Minibus / Ferry Route</label>
          <input type="text" id="busRoutes" name="busRoutes" class="form-control" value="<%= trail.busRoutes || '' %>">
        </div>
      </div>

      <div class="form-grid">
        <div class="form-group">
          <label for="returnTransport">Return Transport</label>
          <input type="text" id="returnTransport" name="returnTransport" class="form-control" value="<%= trail.returnTransport || '' %>">
        </div>
        <div class="form-group">
          <label for="googleMapsUrl">Google Maps Trailhead URL</label>
          <input type="url" id="googleMapsUrl" name="googleMapsUrl" class="form-control" value="<%= trail.googleMapsUrl || '' %>">
        </div>
      </div>

      <div class="form-group">
        <label for="gearChecklist">Recommended Gear (comma-separated)</label>
        <input type="text" id="gearChecklist" name="gearChecklist" class="form-control" value="<%= Array.isArray(trail.gearChecklist) ? trail.gearChecklist.join(', ') : (trail.gearChecklist || '') %>">
      </div>

      <div class="form-group">
        <label for="description">Trail Description *</label>
        <textarea id="description" name="description" class="form-control" required><%= trail.description || '' %></textarea>
      </div>

      <div class="form-group">
        <label for="safetyNotes">Safety Notes</label>
        <textarea id="safetyNotes" name="safetyNotes" class="form-control" style="min-height:70px;"><%= trail.safetyNotes || '' %></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-sky">Save Changes</button>
        <a href="/trails/<%= trail._id %>" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
