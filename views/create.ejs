<%- include('partials/header') %>

<div class="container-narrow">
  <div class="workspace-header">
    <div>
      <h1 class="glow-title" data-i18n="nav_add">Add Trail</h1>
      <p class="header-subtitle">Create a Hong Kong hiking route with real MTR/bus transport details.</p>
    </div>
    <a href="/trails" class="btn btn-secondary" data-i18n="btn_all_trails">&larr; All Trails</a>
  </div>

  <div class="panel">
    <% if (error) { %>
      <div class="flash flash-danger" style="margin-bottom:18px;">
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/trails" method="POST">
      <div class="form-grid">
        <div class="form-group">
          <label for="trailName">Trail Name *</label>
          <input type="text" id="trailName" name="trailName" class="form-control" value="<%= form.trailName || '' %>" placeholder="e.g. Sharp Peak (Nam She Tsim)" required>
        </div>
        <div class="form-group">
          <label for="district">District *</label>
          <select id="district" name="district" class="form-control" required>
            <option value="">-- Select District --</option>
            <% districts.forEach((d) => { %>
              <option value="<%= d %>" <%= form.district === d ? 'selected' : '' %>><%= d %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="form-grid-3">
        <div class="form-group">
          <label for="difficulty">Difficulty *</label>
          <select id="difficulty" name="difficulty" class="form-control" required>
            <% difficulties.forEach((lvl) => { %>
              <option value="<%= lvl %>" <%= (form.difficulty || 'Moderate') === lvl ? 'selected' : '' %>><%= lvl %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="trailStatus">Trail Status</label>
          <select id="trailStatus" name="trailStatus" class="form-control">
            <% statuses.forEach((st) => { %>
              <option value="<%= st %>" <%= (form.trailStatus || 'Open') === st ? 'selected' : '' %>><%= st %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="meetupDate">Meetup Date</label>
          <input type="date" id="meetupDate" name="meetupDate" class="form-control" value="<%= form.meetupDate || '' %>">
        </div>
      </div>

      <div class="form-grid-3">
        <div class="form-group">
          <label for="distanceKm">Distance (km) *</label>
          <input type="number" step="0.1" min="0.5" max="150" id="distanceKm" name="distanceKm" class="form-control" value="<%= form.distanceKm || '' %>" placeholder="e.g. 8.5" required>
        </div>
        <div class="form-group">
          <label for="durationHrs">Duration (hours) *</label>
          <input type="number" step="0.5" min="0.5" max="48" id="durationHrs" name="durationHrs" class="form-control" value="<%= form.durationHrs || '' %>" placeholder="e.g. 3.5" required>
        </div>
        <div class="form-group">
          <label for="elevationM">Elevation Gain (m)</label>
          <input type="number" min="0" id="elevationM" name="elevationM" class="form-control" value="<%= form.elevationM || 0 %>" placeholder="e.g. 468">
        </div>
      </div>

      <div class="form-grid">
        <div class="form-group">
          <label for="meetingPoint">Meeting Point *</label>
          <input type="text" id="meetingPoint" name="meetingPoint" class="form-control" value="<%= form.meetingPoint || '' %>" placeholder="e.g. Sai Kung Bus Terminus" required>
        </div>
        <div class="form-group">
          <label for="maxParticipants">Max Participants</label>
          <input type="number" min="1" max="100" id="maxParticipants" name="maxParticipants" class="form-control" value="<%= form.maxParticipants || 12 %>">
        </div>
      </div>

      <div class="form-grid">
        <div class="form-group">
          <label for="nearestMtr">Nearest MTR Station &amp; Exit</label>
          <input type="text" id="nearestMtr" name="nearestMtr" class="form-control" value="<%= form.nearestMtr || '' %>" placeholder="e.g. Shau Kei Wan MTR (Exit A3)">
        </div>
        <div class="form-group">
          <label for="busRoutes">Bus / Minibus / Ferry Route</label>
          <input type="text" id="busRoutes" name="busRoutes" class="form-control" value="<%= form.busRoutes || '' %>" placeholder="e.g. Citybus 9 to To Tei Wan stop">
        </div>
      </div>

      <div class="form-grid">
        <div class="form-group">
          <label for="returnTransport">Return Transport</label>
          <input type="text" id="returnTransport" name="returnTransport" class="form-control" value="<%= form.returnTransport || '' %>" placeholder="e.g. Bus 9 back to Shau Kei Wan MTR">
        </div>
        <div class="form-group">
          <label for="googleMapsUrl">Google Maps Trailhead URL</label>
          <input type="url" id="googleMapsUrl" name="googleMapsUrl" class="form-control" value="<%= form.googleMapsUrl || '' %>" placeholder="Auto-generated if left blank">
        </div>
      </div>

      <div class="form-group">
        <label for="gearChecklist">Recommended Gear (comma-separated)</label>
        <input type="text" id="gearChecklist" name="gearChecklist" class="form-control" value="<%= form.gearChecklist || '' %>" placeholder="e.g. 2L Water, Hiking Poles, Headlamp, Sunscreen">
      </div>

      <div class="form-group">
        <label for="description">Trail Description *</label>
        <textarea id="description" name="description" class="form-control" placeholder="Describe scenery, trail surface, highlights..." required><%= form.description || '' %></textarea>
      </div>

      <div class="form-group">
        <label for="safetyNotes">Safety Notes</label>
        <textarea id="safetyNotes" name="safetyNotes" class="form-control" style="min-height:70px;"><%= form.safetyNotes || 'Bring at least 1.5L of water and check HKO weather warnings before departure.' %></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-emerald">Create Trail</button>
        <a href="/trails" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
