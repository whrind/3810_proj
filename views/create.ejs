<%- include('partials/header') %>

<div class="container-narrow">
  <div class="workspace-header">
    <div>
      <h1 class="glow-title" data-i18n="nav_add">Add Trail</h1>
      <p class="header-subtitle" data-i18n="form_trail_create_intro">Create a Hong Kong hiking route with real MTR/bus transport details.</p>
    </div>
    <a href="/trails" class="btn btn-secondary" data-i18n="btn_all_trails">&larr; All Trails</a>
  </div>

  <div class="panel">
    <% if (error) { %>
      <div class="flash flash-danger" style="margin-bottom:18px;">
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/trails" method="POST">
      <div class="form-grid">
        <div class="form-group">
          <label for="trailName" data-i18n="form_trail_name">Trail Name *</label>
          <input type="text" id="trailName" name="trailName" class="form-control" value="<%= form.trailName || '' %>" data-i18n-placeholder="form_trail_ph_name" placeholder="e.g. Sharp Peak (Nam She Tsim)" required>
        </div>
        <div class="form-group">
          <label for="district" data-i18n="form_trail_district">District *</label>
          <select id="district" name="district" class="form-control" required>
            <option value="" data-i18n="form_trail_select_district">-- Select District --</option>
            <% districts.forEach((d) => { %>
              <option value="<%= d %>" data-i18n="<%= d %>" <%= form.district === d ? 'selected' : '' %>><%= d %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="form-grid-3">
        <div class="form-group">
          <label for="difficulty" data-i18n="form_trail_difficulty">Difficulty *</label>
          <select id="difficulty" name="difficulty" class="form-control" required>
            <% difficulties.forEach((lvl) => { %>
              <option value="<%= lvl %>" data-i18n="<%= lvl %>" <%= (form.difficulty || 'Moderate') === lvl ? 'selected' : '' %>><%= lvl %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="trailStatus" data-i18n="form_trail_status">Trail Status</label>
          <select id="trailStatus" name="trailStatus" class="form-control">
            <% statuses.forEach((st) => { %>
              <option value="<%= st %>" data-i18n="<%= st %>" <%= (form.trailStatus || 'Open') === st ? 'selected' : '' %>><%= st %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="meetupDate" data-i18n="form_trail_date">Meetup Date</label>
          <input type="date" id="meetupDate" name="meetupDate" class="form-control" value="<%= form.meetupDate || '' %>">
        </div>
      </div>

      <div class="form-grid-3">
        <div class="form-group">
          <label for="distanceKm" data-i18n="form_trail_distance">Distance (km) *</label>
          <input type="number" step="0.1" min="0.5" max="150" id="distanceKm" name="distanceKm" class="form-control" value="<%= form.distanceKm || '' %>" data-i18n-placeholder="form_trail_ph_distance" placeholder="e.g. 8.5" required>
        </div>
        <div class="form-group">
          <label for="durationHrs" data-i18n="form_trail_duration">Duration (hours) *</label>
          <input type="number" step="0.5" min="0.5" max="48" id="durationHrs" name="durationHrs" class="form-control" value="<%= form.durationHrs || '' %>" data-i18n-placeholder="form_trail_ph_duration" placeholder="e.g. 3.5" required>
        </div>
        <div class="form-group">
          <label for="elevationM" data-i18n="form_trail_elevation">Elevation Gain (m)</label>
          <input type="number" min="0" id="elevationM" name="elevationM" class="form-control" value="<%= form.elevationM || 0 %>" data-i18n-placeholder="form_trail_ph_elevation" placeholder="e.g. 468">
        </div>
      </div>

      <div class="form-grid">
        <div class="form-group">
          <label for="meetingPoint" data-i18n="form_trail_meeting">Meeting Point *</label>
          <input type="text" id="meetingPoint" name="meetingPoint" class="form-control" value="<%= form.meetingPoint || '' %>" data-i18n-placeholder="form_trail_ph_meeting" placeholder="e.g. Sai Kung Bus Terminus" required>
        </div>
        <div class="form-group">
          <label for="maxParticipants" data-i18n="form_trail_capacity">Max Participants</label>
          <input type="number" min="1" max="100" id="maxParticipants" name="maxParticipants" class="form-control" value="<%= form.maxParticipants || 12 %>">
        </div>
      </div>

      <div class="form-grid">
        <div class="form-group">
          <label for="nearestMtr" data-i18n="form_trail_mtr">Nearest MTR Station &amp; Exit</label>
          <input type="text" id="nearestMtr" name="nearestMtr" class="form-control" value="<%= form.nearestMtr || '' %>" data-i18n-placeholder="form_trail_ph_mtr" placeholder="e.g. Shau Kei Wan MTR (Exit A3)">
        </div>
        <div class="form-group">
          <label for="busRoutes" data-i18n="form_trail_bus">Bus / Minibus / Ferry Route</label>
          <input type="text" id="busRoutes" name="busRoutes" class="form-control" value="<%= form.busRoutes || '' %>" data-i18n-placeholder="form_trail_ph_bus" placeholder="e.g. Citybus 9 to To Tei Wan stop">
        </div>
      </div>

      <div class="form-grid">
        <div class="form-group">
          <label for="returnTransport" data-i18n="form_trail_return">Return Transport</label>
          <input type="text" id="returnTransport" name="returnTransport" class="form-control" value="<%= form.returnTransport || '' %>" data-i18n-placeholder="form_trail_ph_return" placeholder="e.g. Bus 9 back to Shau Kei Wan MTR">
        </div>
        <div class="form-group">
          <label for="googleMapsUrl" data-i18n="form_trail_maps">Google Maps Trailhead URL</label>
          <input type="url" id="googleMapsUrl" name="googleMapsUrl" class="form-control" value="<%= form.googleMapsUrl || '' %>" data-i18n-placeholder="form_trail_ph_maps" placeholder="Auto-generated if left blank">
        </div>
      </div>

      <div class="form-group">
        <label for="imageUrl" data-i18n="form_trail_image_optional">Cover Photo URL (optional)</label>
        <input type="text" id="imageUrl" name="imageUrl" class="form-control" value="<%= form.imageUrl || '' %>" data-i18n-placeholder="form_trail_ph_image" placeholder="Leave blank for automatic regional HK photo, or paste https://...">
      </div>

      <div class="form-group">
        <label for="gearChecklist" data-i18n="form_trail_gear">Recommended Gear (comma-separated)</label>
        <input type="text" id="gearChecklist" name="gearChecklist" class="form-control" value="<%= form.gearChecklist || '' %>" data-i18n-placeholder="form_trail_ph_gear" placeholder="e.g. 2L Water, Hiking Poles, Headlamp, Sunscreen">
      </div>

      <div class="form-group">
        <label for="description" data-i18n="form_trail_description">Trail Description *</label>
        <textarea id="description" name="description" class="form-control" data-i18n-placeholder="form_trail_ph_description" placeholder="Describe scenery, trail surface, highlights..." required><%= form.description || '' %></textarea>
      </div>

      <div class="form-group">
        <label for="safetyNotes" data-i18n="form_trail_safety">Safety Notes</label>
        <textarea id="safetyNotes" name="safetyNotes" class="form-control" style="min-height:70px;"><%= form.safetyNotes || 'Bring at least 1.5L of water and check HKO weather warnings before departure.' %></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-emerald" data-i18n="form_trail_create">Create Trail</button>
        <a href="/trails" class="btn btn-secondary" data-i18n="form_trail_cancel">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
