<%- include('partials/header') %>

<%
  const catRatio = forumStats.totalCategories > 0 ? Math.round((forumStats.activeCategories / forumStats.totalCategories) * 100) : 0;
%>

<div class="workspace-header">
  <div>
    <h1 class="page-title" data-i18n="forum_title">Hiking Forum</h1>
    <p class="header-subtitle" data-i18n="forum_subtitle">Discuss HK trail conditions, gear, safety alerts &amp; find hiking buddies</p>
  </div>
  <div class="header-actions">
    <a href="/api/forum" target="_blank" class="btn btn-sky">Forum JSON API</a>
    <a href="#new-post-panel" class="btn btn-emerald" data-i18n="forum_new_post">Start a New Discussion</a>
  </div>
</div>

<section class="dashboard-panel" aria-label="Forum Dashboard">
  <div class="dashboard-header">
    <h2 class="dashboard-title" data-i18n="forum_stats_heading">Forum Overview</h2>
  </div>

  <div class="dashboard-kpi-grid">
    <div class="kpi-card">
      <div class="kpi-label" data-i18n="forum_stat_posts">Total Discussions</div>
      <div class="kpi-value"><%= forumStats.totalPosts %></div>
      <div class="kpi-sub" data-i18n="forum_stat_posts_sub">Published community threads</div>
    </div>

    <div class="kpi-card">
      <div class="kpi-label" data-i18n="forum_stat_replies">Total Replies</div>
      <div class="kpi-value"><%= forumStats.totalReplies %></div>
      <div class="kpi-sub" data-i18n="forum_stat_replies_sub">Hiker comments &amp; updates</div>
    </div>

    <div class="kpi-card">
      <div class="kpi-label" data-i18n="forum_stat_likes">Total Stars</div>
      <div class="kpi-value"><%= forumStats.totalLikes %></div>
      <div class="kpi-sub" data-i18n="forum_stat_likes_sub">Helpful thread upvotes</div>
    </div>

    <div class="kpi-card">
      <div class="kpi-label" data-i18n="forum_stat_cats">Active Categories</div>
      <div class="kpi-value text-emerald"><%= forumStats.activeCategories %> / <%= forumStats.totalCategories %></div>
      <div class="kpi-progress" aria-hidden="true">
        <div class="kpi-progress-bar" style="width:<%= catRatio %>%;"></div>
      </div>
      <div class="kpi-sub" data-i18n="forum_stat_cats_sub">Topics with active threads</div>
    </div>
  </div>
</section>

<div class="app-shell">
  <aside class="sidebar">
    <a href="/forum" class="sidebar-all-btn <%= !filters.category ? 'active' : '' %>">
      <span data-i18n="forum_all_posts">All Discussions</span>
      <span class="badge badge-neutral"><%= totalPosts %></span>
    </a>

    <% categoryStats.forEach((c) => { %>
      <a
        href="/forum?category=<%= encodeURIComponent(c.name) %>"
        class="sidebar-card <%= filters.category === c.name ? 'active' : '' %>"
      >
        <div class="sidebar-card-title">
          <span data-i18n="<%= c.name %>"><%= c.name %></span>
          <span class="badge badge-neutral"><%= c.count %></span>
        </div>
        <div class="sidebar-row-link">
          <span data-i18n="sidebar_filter_link">Click to filter</span>
          <span>&rarr;</span>
        </div>
      </a>
    <% }) %>
  </aside>

  <section>
    <div class="panel filter-panel">
      <form action="/forum" method="GET">
        <% if (filters.category) { %>
          <input type="hidden" name="category" value="<%= filters.category %>">
        <% } %>

        <div class="filter-grid-forum">
          <div>
            <label for="q" class="filter-label" data-i18n="lbl_keyword">Keyword Search</label>
            <input type="text" id="q" name="q" class="form-control" value="<%= filters.q %>" placeholder="Search title, topic, author...">
          </div>

          <div>
            <label for="dateFrom" class="filter-label" data-i18n="forum_filter_from">Date From</label>
            <input type="date" id="dateFrom" name="dateFrom" class="form-control" value="<%= filters.dateFrom %>">
          </div>

          <div>
            <label for="dateTo" class="filter-label" data-i18n="forum_filter_to">Date To</label>
            <input type="date" id="dateTo" name="dateTo" class="form-control" value="<%= filters.dateTo %>">
          </div>

          <div>
            <label for="trail" class="filter-label" data-i18n="forum_lbl_trail">Related Trail</label>
            <select id="trail" name="trail" class="form-control">
              <option value="">All Trails</option>
              <option value="General" <%= filters.trail === 'General' ? 'selected' : '' %>>General</option>
              <% trailOptions.forEach(({ _id, trailName }) => { %>
                <option value="<%= _id %>" <%= [String(_id), trailName].includes(filters.trail) ? 'selected' : '' %>><%= trailName %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label for="sort" class="filter-label" data-i18n="lbl_sort">Sort By</label>
            <select id="sort" name="sort" class="form-control">
              <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest First</option>
              <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
              <option value="most_liked" <%= filters.sort === 'most_liked' ? 'selected' : '' %>>Most Liked</option>
              <option value="most_commented" <%= filters.sort === 'most_commented' ? 'selected' : '' %>>Most Discussed</option>
            </select>
          </div>
        </div>

        <div class="filter-actions">
          <div class="date-presets">
            <button type="button" class="btn btn-secondary btn-sm" data-date-preset="today" data-i18n="forum_preset_today">Today</button>
            <button type="button" class="btn btn-secondary btn-sm" data-date-preset="7d" data-i18n="forum_preset_7d">Last 7 Days</button>
            <button type="button" class="btn btn-secondary btn-sm" data-date-preset="30d" data-i18n="forum_preset_30d">Last 30 Days</button>
            <button type="button" class="btn btn-secondary btn-sm" data-date-preset="all" data-i18n="forum_preset_all">All Dates</button>
          </div>
          <div style="display:flex; gap:8px;">
            <a href="/forum" class="btn btn-secondary btn-sm" data-i18n="btn_reset">Reset</a>
            <button type="submit" class="btn btn-sky btn-sm" data-i18n="btn_search">Search &amp; Filter</button>
          </div>
        </div>
      </form>
    </div>

    <% if (posts.length === 0) { %>
      <div class="empty-state" style="margin-bottom:22px;">
        <h3>No discussions match your filter</h3>
        <p>Try widening the date range or start a new hiking topic below.</p>
      </div>
    <% } else { %>
      <div class="forum-list" style="margin-bottom:24px;">
        <% posts.forEach((post) => { %>
          <%
            const liked = post.likes && post.likes.includes(currentUser.username);
            const dateStr = formatHkDate(post.createdAt);
            const allowed = canModify(currentUser, post.author);
            const catClass =
              post.category === 'Safety Alert'
                ? 'badge-expert'
                : post.category === 'Hiking Buddies'
                ? 'badge-challenging'
                : post.category === 'Gear & Tips'
                ? 'badge-moderate'
                : 'badge-easy';
          %>
          <article class="forum-post" id="post-<%= post._id %>">
            <div class="forum-post-header">
              <div>
                <div class="trail-badges">
                  <span class="badge <%= catClass %>" data-i18n="<%= post.category %>"><%= post.category %></span>
                  <span class="badge badge-neutral"><%= post.relatedTrail || 'General' %></span>
                </div>
                <h2 class="forum-post-title"><%= post.title %></h2>
                <div class="forum-post-meta">
                  <span data-i18n="lbl_posted_by">Posted by</span> <strong><%= post.authorDisplayName %></strong> (@<%= post.author %>) &middot; <%= dateStr %> (HKT)
                </div>
              </div>

              <% if (allowed) { %>
                <form
                  action="/forum/<%= post._id %>/delete"
                  method="POST"
                  data-confirm="Delete discussion '<%= post.title %>'?"
                >
                  <button type="submit" class="btn btn-danger btn-sm" data-i18n="btn_delete">Delete</button>
                </form>
              <% } %>
            </div>

            <div class="forum-post-body"><%= post.content %></div>

            <div class="forum-post-actions">
              <div style="display:flex; gap:8px; align-items:center;">
                <form action="/forum/<%= post._id %>/like" method="POST" style="display:inline;">
                  <button type="submit" class="btn btn-sm <%= liked ? 'btn-gold' : 'btn-secondary' %>">
                    &#9733; <%= post.likes ? post.likes.length : 0 %>
                  </button>
                </form>
                <span style="font-size:0.83rem; color:var(--text-muted);">
                  <%= post.comments ? post.comments.length : 0 %> <span data-i18n="lbl_replies">replies</span>
                </span>
              </div>
            </div>

            <div class="comments-box">
              <% if (post.comments && post.comments.length > 0) { %>
                <% post.comments.forEach((c) => { %>
                  <div class="comment-item">
                    <div class="comment-meta">
                      <strong><%= c.authorDisplayName %></strong> (@<%= c.author %>) &middot;
                      <%= formatHkDate(c.createdAt) %>
                    </div>
                    <div><%= c.text %></div>
                  </div>
                <% }) %>
              <% } %>

              <form action="/forum/<%= post._id %>/comment" method="POST" class="comment-form">
                <input
                  type="text"
                  name="text"
                  class="form-control"
                  placeholder="Write a reply..."
                  data-i18n-placeholder="forum_reply_ph"
                  maxlength="600"
                  required
                >
                <button type="submit" class="btn btn-sky btn-sm" data-i18n="forum_btn_reply">Reply</button>
              </form>
            </div>
          </article>
        <% }) %>
      </div>

      <% if (pagination.totalPages > 1) { %>
        <%
          const qs = new URLSearchParams();
          if (filters.q) qs.set('q', filters.q);
          if (filters.category) qs.set('category', filters.category);
          if (filters.trail) qs.set('trail', filters.trail);
          if (filters.dateFrom) qs.set('dateFrom', filters.dateFrom);
          if (filters.dateTo) qs.set('dateTo', filters.dateTo);
          if (filters.sort) qs.set('sort', filters.sort);
        %>
        <nav class="pagination-bar" style="margin-bottom:22px;">
          <% if (pagination.page > 1) { qs.set('page', pagination.page - 1); %>
            <a href="/forum?<%= qs.toString() %>" class="btn btn-secondary btn-sm">&larr; Prev</a>
          <% } %>
          <span class="pagination-info">Page <%= pagination.page %> / <%= pagination.totalPages %></span>
          <% if (pagination.page < pagination.totalPages) { qs.set('page', pagination.page + 1); %>
            <a href="/forum?<%= qs.toString() %>" class="btn btn-secondary btn-sm">Next &rarr;</a>
          <% } %>
        </nav>
      <% } %>
    <% } %>

    <div class="panel" id="new-post-panel">
      <h2 style="font-size:1.2rem; margin-bottom:14px;" data-i18n="forum_new_post">Start a New Discussion</h2>
      <form action="/forum" method="POST">
        <div class="form-group">
          <label for="title" data-i18n="forum_lbl_title">Discussion Title *</label>
          <input type="text" id="title" name="title" class="form-control" placeholder="e.g. Muddy steps on Lion Rock after rain?" required>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label for="category" data-i18n="forum_lbl_cat">Category *</label>
            <select id="category" name="category" class="form-control" required>
              <% forumCategories.forEach((cat) => { %>
                <option value="<%= cat %>" data-i18n="<%= cat %>"><%= cat %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label for="relatedTrailId" data-i18n="forum_lbl_trail">Related Trail</label>
            <select id="relatedTrailId" name="relatedTrailId" class="form-control">
              <option value="">General</option>
              <% trailOptions.forEach(({ _id, trailName }) => { %>
                <option value="<%= _id %>"><%= trailName %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="content" data-i18n="forum_lbl_content">Message *</label>
          <textarea id="content" name="content" class="form-control" placeholder="Share trail updates, transport tips, gear advice, or meetup plans..." required></textarea>
        </div>

        <button type="submit" class="btn btn-emerald" data-i18n="forum_btn_publish">Publish Post</button>
      </form>
    </div>
  </section>
</div>

<%- include('partials/footer') %>
