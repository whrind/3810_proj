<%- include('partials/header') %>

<div class="app-shell">
  <!-- Left Sidebar: Forum Categories -->
  <aside class="sidebar">
    <div class="sidebar-panel sidebar-choices">
      <div class="sidebar-section-label" data-i18n="sidebar_categories">Categories</div>
      <a href="/forum" class="sidebar-item <%= !filters.category ? 'active' : '' %>">
        <span class="sidebar-item-name" data-i18n="forum_all_posts">All Discussions</span>
        <span class="sidebar-count"><%= totalPosts %></span>
      </a>

      <% categoryStats.forEach((c) => { %>
        <a
          href="/forum?category=<%= encodeURIComponent(c.name) %>"
          class="sidebar-item <%= filters.category === c.name ? 'active' : '' %>"
        >
          <span class="sidebar-item-name" data-i18n="<%= c.name %>"><%= c.name %></span>
          <span class="sidebar-count"><%= c.count %></span>
        </a>
      <% }) %>
    </div>
  </aside>

  <!-- Main Forum Workspace -->
  <section>
    <div class="workspace-header">
      <div>
        <h1 class="page-title" data-i18n="forum_title">Hiking Forum</h1>
        <% if (demoMode) { %>
          <p class="header-subtitle" data-i18n="forum_demo">Includes sample posts for the course demo.</p>
        <% } %>
      </div>
      <div class="header-actions">
        <a href="/api/forum" target="_blank" rel="noopener" class="btn btn-sky">Forum JSON API</a>
        <a href="#new-post-panel" class="btn btn-emerald" data-i18n="forum_new_post">New post</a>
      </div>
    </div>

    <!-- Forum Multi-Condition Filter (Keyword, Date Range, Trail, Sort) -->
    <div class="panel filter-panel">
      <form action="/forum" method="GET">
        <% if (filters.category) { %>
          <input type="hidden" name="category" value="<%= filters.category %>">
        <% } %>

        <div class="filter-grid-forum">
          <div>
            <label for="q" class="filter-label" data-i18n="lbl_keyword">Keyword Search</label>
            <input type="text" id="q" name="q" class="form-control" value="<%= filters.q %>" placeholder="Search title, topic, author...">
          </div>

          <div>
            <label for="dateFrom" class="filter-label" data-i18n="forum_filter_from">Date From</label>
            <input type="date" id="dateFrom" name="dateFrom" class="form-control" value="<%= filters.dateFrom %>">
          </div>

          <div>
            <label for="dateTo" class="filter-label" data-i18n="forum_filter_to">Date To</label>
            <input type="date" id="dateTo" name="dateTo" class="form-control" value="<%= filters.dateTo %>">
          </div>

          <div>
            <label for="trail" class="filter-label" data-i18n="forum_lbl_trail">Related Trail</label>
            <select id="trail" name="trail" class="form-control">
              <option value="">All Trails</option>
              <option value="General" <%= filters.trail === 'General' ? 'selected' : '' %>>General</option>
              <% trailNames.forEach((tn) => { %>
                <option value="<%= tn %>" <%= filters.trail === tn ? 'selected' : '' %>><%= tn %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label for="sort" class="filter-label" data-i18n="lbl_sort">Sort By</label>
            <select id="sort" name="sort" class="form-control">
              <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest First</option>
              <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
              <option value="most_liked" <%= filters.sort === 'most_liked' ? 'selected' : '' %>>Most Liked</option>
              <option value="most_commented" <%= filters.sort === 'most_commented' ? 'selected' : '' %>>Most Discussed</option>
            </select>
          </div>
        </div>

        <div class="filter-actions">
          <div class="date-presets">
            <button type="button" class="btn btn-secondary btn-sm" data-date-preset="today" data-i18n="forum_preset_today">Today</button>
            <button type="button" class="btn btn-secondary btn-sm" data-date-preset="7d" data-i18n="forum_preset_7d">Last 7 Days</button>
            <button type="button" class="btn btn-secondary btn-sm" data-date-preset="30d" data-i18n="forum_preset_30d">Last 30 Days</button>
            <button type="button" class="btn btn-secondary btn-sm" data-date-preset="all" data-i18n="forum_preset_all">All Dates</button>
          </div>
          <div style="display:flex; gap:8px;">
            <a href="/forum" class="btn btn-secondary btn-sm" data-i18n="btn_reset">Reset</a>
            <button type="submit" class="btn btn-sky btn-sm" data-i18n="btn_search">Search &amp; Filter</button>
          </div>
        </div>
      </form>
    </div>

    <!-- Discussion Feed -->
    <% if (posts.length === 0) { %>
      <div class="empty-state" style="margin-bottom:22px;">
        <h3 data-i18n="forum_empty">No posts match these filters.</h3>
        <a href="/forum" class="btn btn-secondary" data-i18n="btn_reset">Reset</a>
      </div>
    <% } else { %>
      <div class="forum-list" style="margin-bottom:24px;">
        <% posts.forEach((post) => { %>
          <%
            const liked = post.likes && post.likes.includes(currentUser.username);
            const dateStr = formatForumDate(post.createdAt);
            const catClass =
              post.category === 'Safety Alert'
                ? 'badge-expert'
                : post.category === 'Hiking Buddies'
                ? 'badge-challenging'
                : post.category === 'Gear & Tips'
                ? 'badge-moderate'
                : 'badge-easy';
          %>
          <article class="forum-post" id="post-<%= post._id %>">
            <div class="forum-post-header">
              <div>
                <div class="trail-badges">
                  <span class="badge <%= catClass %>" data-i18n="<%= post.category %>"><%= post.category %></span>
                  <span class="badge badge-neutral"><%= post.relatedTrail || 'General' %></span>
                </div>
                <h2 class="forum-post-title"><%= post.title %></h2>
                <div class="forum-post-meta">
                  Posted by <strong><%= post.authorDisplayName %></strong> (@<%= post.author %>) &middot; <%= dateStr %>
                </div>
              </div>

              <% if (canManage(currentUser, post.author)) { %>
                <form
                  action="/forum/<%= post._id %>/delete"
                  method="POST"
                  data-confirm="Delete discussion '<%= post.title %>'?"
                >
                  <button type="submit" class="btn btn-danger btn-sm" data-i18n="btn_delete">Delete</button>
                </form>
              <% } %>
            </div>

            <div class="forum-post-body"><%= post.content %></div>

            <div class="forum-post-actions">
              <div style="display:flex; gap:8px; align-items:center;">
                <form action="/forum/<%= post._id %>/like" method="POST" style="display:inline;">
                  <button type="submit" class="btn btn-sm <%= liked ? 'btn-gold' : 'btn-secondary' %>">
                    &#9733; <%= post.likes ? post.likes.length : 0 %>
                  </button>
                </form>
                <span style="font-size:0.83rem; color:var(--text-muted);">
                  <%= post.comments ? post.comments.length : 0 %> replies
                </span>
              </div>
            </div>

            <div class="comments-box">
              <% if (post.comments && post.comments.length > 0) { %>
                <% post.comments.forEach((c) => { %>
                  <div class="comment-item">
                    <div class="comment-meta">
                      <strong><%= c.authorDisplayName %></strong> (@<%= c.author %>) &middot;
                      <%= formatForumDate(c.createdAt) %>
                    </div>
                    <div><%= c.text %></div>
                  </div>
                <% }) %>
              <% } %>

              <form action="/forum/<%= post._id %>/comment" method="POST" class="comment-form">
                <input
                  type="text"
                  name="text"
                  class="form-control"
                  placeholder="Write a reply..."
                  data-i18n-placeholder="forum_reply_ph"
                  required
                >
                <button type="submit" class="btn btn-sky btn-sm" data-i18n="forum_btn_reply">Reply</button>
              </form>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>

    <!-- Create New Discussion Form -->
    <div class="panel" id="new-post-panel">
      <h2 style="font-size:1.2rem; margin-bottom:14px;" data-i18n="forum_new_post">New post</h2>
      <form action="/forum" method="POST">
        <div class="form-group">
          <label for="title" data-i18n="forum_lbl_title">Discussion Title *</label>
          <input type="text" id="title" name="title" class="form-control" placeholder="e.g. Muddy steps on Lion Rock after rain?" required>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label for="category" data-i18n="forum_lbl_cat">Category *</label>
            <select id="category" name="category" class="form-control" required>
              <% forumCategories.forEach((cat) => { %>
                <option value="<%= cat %>" data-i18n="<%= cat %>"><%= cat %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label for="relatedTrail" data-i18n="forum_lbl_trail">Related Trail</label>
            <select id="relatedTrail" name="relatedTrail" class="form-control">
              <option value="General">General</option>
              <% trailNames.forEach((tn) => { %>
                <option value="<%= tn %>"><%= tn %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="content" data-i18n="forum_lbl_content">Message *</label>
          <textarea id="content" name="content" class="form-control" placeholder="Share trail updates, transport tips, gear advice, or meetup plans..." required></textarea>
        </div>

        <button type="submit" class="btn btn-emerald" data-i18n="forum_btn_publish">Publish Post</button>
      </form>
    </div>
  </section>
</div>

<%- include('partials/footer') %>
